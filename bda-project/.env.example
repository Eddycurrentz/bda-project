# Copy this file to .env before starting Compose and replace every CHANGE_ME value.
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
SENTINEL_JWT_SECRET=CHANGE_ME_use_at_least_32_random_bytes
SENTINEL_DEMO_EMAIL=admin@sentinelpulse.local
SENTINEL_DEMO_PASSWORD=CHANGE_ME_use_a_strong_demo_password
SENTINEL_COOKIE_SECURE=false
SENTINEL_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SentinelPulse <no-reply@example.local>
PUBLIC_BASE_URL=http://127.0.0.1:8000
